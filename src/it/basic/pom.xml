<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example</groupId>
  <artifactId>supply-chain-verification-it</artifactId>
  <version>1.0-SNAPSHOT</version>

  <repositories>
    <repository>
      <id>fixture-pom-repository</id>
      <url>file://${project.basedir}/repo-pom</url>
    </repository>
    <repository>
      <id>fixture-jar-repository</id>
      <url>file://${project.basedir}/repo-jar</url>
    </repository>
    <repository>
      <id>fixture-repository</id>
      <url>file://${project.basedir}/repo</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.example</groupId>
      <artifactId>evidence-fixture</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.example</groupId>
      <artifactId>no-sidecar</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.example</groupId>
      <artifactId>split-provenance</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>plugin-identity-fixture</id>
            <phase>validate</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target><echo>plugin identity fixture</echo></target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.mcc0nnell</groupId>
        <artifactId>supply-chain-verification-maven-plugin</artifactId>
        <version>@project.version@</version>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <requestTimeoutSeconds>1</requestTimeoutSeconds>
          <reportFile>${project.build.directory}/evidence.ndjson</reportFile>
          <failOnFailure>false</failOnFailure>
          <failOnUnknown>false</failOnUnknown>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
